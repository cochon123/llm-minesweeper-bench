#!/usr/bin/env bash
# cli2api hardcodes --sandbox enabled, which AppArmor rejects on this machine.
# Ask mode is already read-only; keep that, drop the broken sandbox flag.
args=()
skip_next=0
for arg in "$@"; do
  if [[ $skip_next -eq 1 ]]; then
    skip_next=0
    if [[ "$arg" == "enabled" ]]; then
      args+=("disabled")
    else
      args+=("$arg")
    fi
    continue
  fi
  if [[ "$arg" == "--sandbox" ]]; then
    args+=("$arg")
    skip_next=1
    continue
  fi
  args+=("$arg")
done
CURSOR_AGENT_BIN="${CURSOR_AGENT_BIN:-$(command -v cursor-agent || echo "$HOME/.local/bin/cursor-agent")}"
exec "$CURSOR_AGENT_BIN" "${args[@]}"
